{% extends 'layouts/main.html.twig' %}
{% block title %}Configuración{% endblock %}
{% block content %}
<div class="page-heading"><div><h1>Configuración</h1><p class="text-body-secondary">Personaliza la apariencia del sistema.</p></div></div>
<form class="card mb-4" method="post" action="/configuracion"><div class="card-body">
<input type="hidden" name="csrf" value="{{ csrf }}">
<fieldset class="mb-4"><legend class="h5">Color principal</legend><div class="color-options">
{% for value,label in appearance %}<label class="color-option" title="{{ label }}"><input type="radio" name="primary_color" value="{{ value }}" {{ settings.primary_color==value ? 'checked' : '' }} required><span style="--swatch: {{ value }}"></span><small>{{ label }}</small></label>{% endfor %}
</div></fieldset>
<fieldset class="mb-4"><legend class="h5">Tema</legend><div class="d-flex gap-4">
{% for value,label in {'light':'Claro','dark':'Oscuro'} %}<label class="form-check"><input class="form-check-input" type="radio" name="theme" value="{{ value }}" {{ settings.theme|default('light')==value ? 'checked' : '' }}> {{ label }}</label>{% endfor %}
</div></fieldset><button class="btn btn-success">Guardar preferencias</button></div></form>
<section class="card"><div class="card-body"><h2 class="h5">Sistema y actualizaciones</h2><p>Sistema de gestión veterinaria · STRUCH VET · <strong>v{{ system_version }}</strong></p><p class="text-body-secondary">Creado por {{ system_creator }}</p>
<p>En StruchVet Desktop, utiliza el menú <strong>StruchVet → Comprobar actualizaciones</strong>. La aplicación web se actualiza en su servidor.</p>
</div></section>
{% endblock %}
