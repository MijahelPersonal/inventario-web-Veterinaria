{% extends 'layouts/main.html.twig' %}
{% block title %}Configuración{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">ADMINISTRACIÓN</span><h1>Configuración de la veterinaria</h1></div></div>
<form class="card" method="post" action="/configuracion"><div class="card-body row g-3">
    <input type="hidden" name="csrf" value="{{ csrf }}">
    {% for key,label in {'clinic_name':'Nombre comercial','contact_phone':'Teléfono','contact_email':'Correo de contacto','address':'Dirección'} %}
    <div class="col-md-6"><label class="form-label" for="{{ key }}">{{ label }}</label><input class="form-control" id="{{ key }}" name="{{ key }}" value="{{ attribute(settings,key) }}" maxlength="{{ key=='address' ? 255 : (key=='contact_email' ? 190 : (key=='contact_phone' ? 40 : 120)) }}" {{ key=='clinic_name' ? 'required' : '' }}></div>
    {% endfor %}
    <div class="col-md-6"><label class="form-label" for="currency">Moneda</label><select class="form-select" id="currency" name="currency">{% for value in ['PEN','USD','EUR'] %}<option {{ settings.currency==value ? 'selected' : '' }}>{{ value }}</option>{% endfor %}</select></div>
    <div class="col-md-6"><label class="form-label" for="primary_color">Color principal</label><input class="form-control form-control-color" type="color" id="primary_color" name="primary_color" value="{{ settings.primary_color }}"></div>
    <div class="col-12"><button class="btn btn-primary">Guardar preferencias</button></div>
</div></form>
<p class="small text-body-secondary mt-3">Versión 0.1 · Zona horaria: America/Lima. Los cambios de moneda no convierten importes históricos.</p>
{% endblock %}
