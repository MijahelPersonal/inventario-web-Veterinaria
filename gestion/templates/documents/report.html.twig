<!doctype html><html lang="es"><head><meta charset="utf-8"><style>@page{margin:24px}body{font-family:DejaVu Sans,sans-serif;font-size:8px;color:#17304b}h1{font-size:18px}table{width:100%;border-collapse:collapse}td,th{padding:5px;border:1px solid #dce4f0;text-align:left}thead{display:table-header-group}tr{page-break-inside:avoid}</style></head><body>
<h1>{{ app_name }} · {{ title }}</h1><p>{{ start }} a {{ end }} · {{ rows|length }} registros</p><table><thead><tr>{% for label in headers %}<th>{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr>{% for key,label in headers %}<td>{{ attribute(row,key) }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ headers|length }}">Sin registros.</td></tr>{% endfor %}</tbody></table><p>Documento de consulta interna.</p>
</body></html>
