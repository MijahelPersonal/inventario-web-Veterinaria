{% extends 'layouts/main.html.twig' %}
{% block title %}Reportes{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">CONSULTA Y EXPORTACIÓN</span><h1>Reportes</h1></div><div><a class="btn btn-outline-primary" href="/reportes/csv?{{ query }}">CSV</a> <a class="btn btn-primary" href="/reportes/pdf?{{ query }}">PDF</a></div></div>
<form class="card card-body mb-4" method="get"><div class="row g-3">
<div class="col-md-4"><label class="form-label">Reporte<select class="form-select" name="type">{% for key,label in types %}<option value="{{ key }}" {{ key==type ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label></div>
<div class="col-md-4"><label class="form-label">Desde<input class="form-control" type="date" name="start" value="{{ start }}" required></label></div><div class="col-md-4"><label class="form-label">Hasta<input class="form-control" type="date" name="end" value="{{ end }}" required></label></div>
<div class="col-md-4"><label class="form-label">Veterinario (solo citas)<select class="form-select" name="vet"><option value="">Todos</option>{% for row in veterinarians %}<option value="{{ row.id }}" {{ row.id==filters.vet|default('') ? 'selected' : '' }}>{{ row.name }}</option>{% endfor %}</select></label></div>
<div class="col-md-4"><label class="form-label">Mascota (solo citas)<select class="form-select" name="pet"><option value="">Todas</option>{% for row in pets %}<option value="{{ row.id }}" {{ row.id==filters.pet|default('') ? 'selected' : '' }}>{{ row.name }}</option>{% endfor %}</select></label></div>
<div class="col-md-4"><label class="form-label">Estado (solo citas)<select class="form-select" name="status"><option value="">Todos</option>{% for key,label in states %}<option value="{{ key }}" {{ key==filters.status|default('') ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select></label></div>
<div class="col-12"><button class="btn btn-primary">Filtrar reporte</button> <a class="btn btn-outline-secondary" href="/reportes">Limpiar filtros</a></div></div></form>
{% if type=='citas' %}<div class="row g-3 mb-4">{% for label,value in {'TOTAL DE CONSULTAS':metrics.count,'ATENDIDAS':metrics.attended,'COBRADO POR ESTAS CITAS':metrics.collected,'SALDO DE CARGOS EMITIDOS':metrics.outstanding} %}<div class="col-md-3"><div class="card card-body report-metric"><small class="text-body-secondary">{{ label }}</small><strong class="fs-3 mt-2">{{ value }}</strong></div></div>{% endfor %}</div>{% endif %}
<div class="card"><div class="card-header">{{ title }} · {{ start }} a {{ end }} · {{ rows|length }} registros</div><div class="table-responsive"><table class="table mb-0"><thead><tr>{% for label in headers %}<th>{{ label }}</th>{% endfor %}</tr></thead><tbody>{% for row in rows %}<tr>{% for key,label in headers %}<td>{{ attribute(row,key) }}</td>{% endfor %}</tr>{% else %}<tr><td colspan="{{ headers|length }}" class="text-center py-4">Sin registros para estos filtros.</td></tr>{% endfor %}</tbody></table></div></div>
<p class="small text-body-secondary mt-3">Ventas y cobros tienen fechas distintas. El cobrado neto de una venta incluye sus cobros y reversiones hasta hoy. Los importes no representan utilidad neta.</p>
{% endblock %}
