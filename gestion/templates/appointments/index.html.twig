{% extends 'layouts/main.html.twig' %}
{% block title %}Agenda{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">ATENCIÓN VETERINARIA</span><h1>Agenda de citas</h1></div></div>
<form class="row g-2 mb-4" method="get">
    <div class="col-sm-4"><label class="form-label" for="month">Mes del listado</label><input class="form-control" id="month" type="month" name="month" value="{{ month }}"></div>
    <div class="col-sm-5"><label class="form-label" for="vet">Veterinario</label><select class="form-select" id="vet" name="vet"><option value="">Todos</option>{% for row in veterinarians %}<option value="{{ row.id }}" {{ row.id==vet ? 'selected' : '' }}>{{ row.name }}</option>{% endfor %}</select></div>
    <div class="col-sm-3 d-flex align-items-end"><button class="btn btn-outline-secondary">Filtrar</button></div>
</form>
<div class="card mb-4"><div class="card-body"><div id="calendar" data-vet="{{ vet }}"></div><p class="text-body-secondary small mt-3 mb-0">Las citas solicitadas reservan el horario. Cancelar o marcar «no asistió» lo libera.</p></div></div>
{% if can('appointments.write') %}
<details class="card mb-4"><summary class="card-header">Registrar cita</summary><form method="post" action="/citas" class="card-body row g-3">
    <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ request_key }}">
    <div class="col-md-6"><label class="form-label" for="pet_id">Mascota y responsable</label><select class="form-select" id="pet_id" name="pet_id" required><option value="">Seleccionar</option>{% for row in pets %}{% if row.active %}<option value="{{ row.id }}">{{ row.name }}</option>{% endif %}{% endfor %}</select></div>
    <div class="col-md-6"><label class="form-label" for="service_id">Servicio</label><select class="form-select" id="service_id" name="service_id" required><option value="">Seleccionar</option>{% for row in services %}{% if row.active %}<option value="{{ row.id }}">{{ row.name }}</option>{% endif %}{% endfor %}</select></div>
    <div class="col-md-4"><label class="form-label" for="veterinarian_id">Veterinario</label><select class="form-select" id="veterinarian_id" name="veterinarian_id" required><option value="">Seleccionar</option>{% for row in veterinarians %}{% if row.active %}<option value="{{ row.id }}">{{ row.name }}</option>{% endif %}{% endfor %}</select></div>
    <div class="col-md-4"><label class="form-label" for="start_at">Fecha y hora</label><input class="form-control" id="start_at" type="datetime-local" name="start_at" required></div>
    <div class="col-md-4"><label class="form-label" for="source">Origen</label><select class="form-select" id="source" name="source"><option value="manual">Registro manual</option><option value="whatsapp">Solicitud por WhatsApp</option></select></div>
    <div class="col-12"><label class="form-label" for="notes">Notas administrativas</label><textarea class="form-control" id="notes" name="notes" maxlength="3000"></textarea></div>
    <div class="col-12"><button class="btn btn-primary">Registrar cita</button></div>
</form></details>
{% endif %}
<div class="card mb-4"><div class="card-header">Citas de {{ month }}</div><div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Horario</th><th>Mascota / cliente</th><th>Servicio / veterinario</th><th>Estado</th><th>Actualizar</th></tr></thead><tbody>
{% for row in appointments %}<tr><td>{{ row.start_at|date('d/m H:i') }}–{{ row.end_at|date('H:i') }}</td><td>{{ row.pet_name }}<small class="d-block text-body-secondary">{{ row.client_name }}</small></td><td>{{ row.service_name }}<small class="d-block text-body-secondary">{{ row.veterinarian_name }} · {{ row.price }}</small></td><td>{{ attribute(states,row.status) }}</td><td>
{% if can('appointments.write') %}<form class="d-flex gap-2" method="post" action="/citas/{{ row.id }}/estado"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="notes" value="{{ row.notes }}"><select name="status" class="form-select form-select-sm" aria-label="Estado de cita {{ row.id }}">{% for key,label in states %}<option value="{{ key }}" {{ row.status==key ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select><button class="btn btn-sm btn-outline-primary">Guardar</button></form>{% endif %}
</td></tr>{% else %}<tr><td colspan="5" class="text-center py-4">No hay citas en este periodo.</td></tr>{% endfor %}
</tbody></table></div></div>
{% if can('appointments.schedule') %}
<details class="card"><summary class="card-header">Disponibilidad semanal</summary><div class="card-body">
<p class="text-body-secondary">Sin horarios propios, se permite de 08:00 a 20:00 todos los días. Al registrar el primer horario, solo estarán disponibles los días configurados. Las citas ya registradas no cambian.</p>
<form action="/citas/horarios" method="post" class="row g-3"><input type="hidden" name="csrf" value="{{ csrf }}">
<div class="col-md-3"><label class="form-label">Veterinario<select name="veterinarian_id" class="form-select" required>{% for row in veterinarians %}<option value="{{ row.id }}">{{ row.name }}</option>{% endfor %}</select></label></div>
<div class="col-md-3"><label class="form-label">Día<select class="form-select" name="weekday">{% for day,label in {1:'Lunes',2:'Martes',3:'Miércoles',4:'Jueves',5:'Viernes',6:'Sábado',7:'Domingo'} %}<option value="{{ day }}">{{ label }}</option>{% endfor %}</select></label></div>
<div class="col-md-2"><label class="form-label">Desde<input class="form-control" name="start_time" type="time" required></label></div><div class="col-md-2"><label class="form-label">Hasta<input class="form-control" name="end_time" type="time" required></label></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-outline-primary mb-2">Guardar</button></div>
</form></div></details>
{% endif %}
{% endblock %}
