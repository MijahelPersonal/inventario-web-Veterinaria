{% extends 'layouts/main.html.twig' %}
{% block title %}Citas y agenda{% endblock %}
{% block content %}
<div class="page-heading"><div><h1>Agenda de consultas veterinarias</h1><p class="text-body-secondary mb-0">Control de citas, vacunaciones y servicios por mascota y veterinario.</p></div>{% if can('appointments.write') %}<a class="btn btn-primary" href="#nueva-cita" data-open-details="nueva-cita">＋ Agendar consulta</a>{% endif %}</div>
<div class="section-tabs mb-3">{% for key,label in {'all':'Todas las citas','pending':'Citas pendientes','past':'Historial pasado'} %}<a class="{{ filter==key ? 'selected' : '' }}" href="/citas?month={{ month }}&vet={{ vet }}&filter={{ key }}">{{ label }}</a>{% endfor %}</div>
{% include 'appointments/filters.html.twig' %}
{% if can('appointments.write') %}{% include 'appointments/form.html.twig' %}{% endif %}
<div class="card mb-4"><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Folio</th><th>Servicio / motivo</th><th>Mascota y responsable</th><th>Veterinario</th><th>Fecha y hora</th><th>Precio</th><th>Estado</th><th>Pago</th><th>Acciones</th></tr></thead><tbody>
{% for row in appointments %}<tr>
<td class="text-body-secondary">#{{ row.id }}</td><td><strong>{{ row.service_name }}</strong><small class="d-block text-body-secondary">{{ row.notes|slice(0,65) }}</small></td>
<td><a href="/fichas/mascotas/{{ row.pet_id }}" class="fw-semibold">♡ {{ row.pet_name }}</a><small class="d-block text-body-secondary">{{ row.species }} · {{ row.breed }}</small><small class="d-block">{{ row.client_name }}</small></td><td>{{ row.veterinarian_name }}</td><td>{{ row.start_at|date('d/m/Y') }}<small class="d-block text-body-secondary">{{ row.start_at|date('H:i') }}–{{ row.end_at|date('H:i') }}</small></td><td class="text-success fw-semibold">{{ row.price }}</td>
<td>{% if can('appointments.write') %}<form class="d-flex gap-1" method="post" action="/citas/{{ row.id }}/estado"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="notes" value="{{ row.notes }}"><select class="form-select form-select-sm" name="status" aria-label="Estado de cita {{ row.id }}">{% for key,label in states %}<option value="{{ key }}" {{ key==row.status ? 'selected' : '' }}>{{ label }}</option>{% endfor %}</select><button class="btn btn-sm btn-outline-secondary" aria-label="Guardar estado de cita {{ row.id }}">✓</button></form>{% else %}<span class="badge status-{{ row.status }}">{{ attribute(states,row.status) }}</span>{% endif %}</td>
<td>{% if row.sale_status=='void' %}<span class="badge text-bg-secondary">Cargo anulado</span>{% elseif row.sale_id and row.paid>=row.price %}<span class="badge text-bg-success">Pagado</span>{% elseif row.paid>0 %}<span class="badge text-bg-warning">Parcial</span>{% else %}<span class="badge text-bg-warning">Pendiente</span>{% endif %}</td>
<td><div class="action-buttons"><a class="btn btn-sm btn-outline-primary" href="/citas/{{ row.id }}">Ver / editar</a>{% if can('clinical.read') %}<a class="btn btn-sm btn-outline-danger" href="/citas/{{ row.id }}/pdf">PDF</a>{% endif %}{% if can('payments.write') %}{% if row.sale_id %}<a class="btn btn-sm btn-success" href="/ventas?venta={{ row.sale_id }}">Cobrar</a>{% elseif row.status in ['confirmada','atendida'] %}<form method="post" action="/ventas"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ request_key }}"><input type="hidden" name="appointment_id" value="{{ row.id }}"><button class="btn btn-sm btn-success">Generar cargo</button></form>{% endif %}{% endif %}</div></td>
</tr>{% else %}<tr><td colspan="9" class="text-center py-5">No hay citas para este mes y filtro.</td></tr>{% endfor %}</tbody></table></div></div>
<small class="text-body-secondary">Hasta 1000 citas por mes. Cancelar conserva el historial; no se borran consultas.</small>
{% if can('appointments.schedule') %}{% include 'appointments/hours.html.twig' %}{% endif %}
{% endblock %}
