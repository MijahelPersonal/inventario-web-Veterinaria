{% extends 'layouts/main.html.twig' %}
{% block title %}Iniciar sesión{% endblock %}
{% block content %}
<div class="login-card card shadow-sm mx-auto"><div class="card-body p-4 p-lg-5">
<span class="eyebrow">GESTIÓN VETERINARIA</span><h1 class="h3 mt-2">Bienvenido de nuevo</h1>
<p class="text-body-secondary">Ingresa con tu cuenta del personal.</p>
<form method="post" action="/login">
<input type="hidden" name="csrf" value="{{ csrf }}">
<label class="form-label" for="email">Correo</label><input class="form-control mb-3" type="email" id="email" name="email" maxlength="190" autocomplete="username" required>
<label class="form-label" for="password">Contraseña</label><input class="form-control mb-4" type="password" id="password" name="password" autocomplete="current-password" required>
<button class="btn btn-primary w-100">Iniciar sesión</button></form></div></div>
{% endblock %}
