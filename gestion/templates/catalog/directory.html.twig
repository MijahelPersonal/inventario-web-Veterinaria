{% extends 'layouts/main.html.twig' %}
{% block title %}{{ slug=='mascotas' ? 'Mascotas y pacientes' : 'Veterinarios' }}{% endblock %}
{% block content %}
<div class="page-heading"><div><h1>{{ slug=='mascotas' ? 'Mascotas y pacientes' : 'Directorio de veterinarios' }}</h1><p class="text-body-secondary mb-0">{{ slug=='mascotas' ? 'Datos de las mascotas, responsables e historial de atenciones.' : 'Personal veterinario, contacto y disponibilidad.' }}</p></div>{% if can('catalogs.write') %}<a class="btn btn-primary" href="/catalogos/{{ slug }}/nuevo">＋ {{ slug=='mascotas' ? 'Nueva mascota' : 'Registrar veterinario' }}</a>{% endif %}</div>
<form class="directory-search card card-body mb-4" method="get"><div class="d-flex gap-2"><input class="form-control" name="q" value="{{ search }}" aria-label="Buscar en directorio" placeholder="{{ slug=='mascotas' ? 'Buscar por mascota, responsable, especie o raza…' : 'Buscar por nombre, correo o colegiatura…' }}"><button class="btn btn-primary px-4">Buscar</button></div></form>
<div class="card table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr>
{% if slug=='mascotas' %}<th>Expediente</th><th>Mascota</th><th>Especie / raza</th><th>Sexo</th><th>Peso</th><th>Responsable</th><th>Contacto</th>{% else %}<th>Colegiatura</th><th>Nombre completo</th><th>Contacto</th><th>Estado</th>{% endif %}<th>Acciones</th></tr></thead><tbody>
{% for row in rows %}<tr>
{% if slug=='mascotas' %}<td><span class="badge text-bg-dark">{{ row.microchip ?: 'VET-'~row.id }}</span></td><td><a class="fw-semibold" href="/fichas/mascotas/{{ row.id }}">♡ {{ row.name }}</a>{% if not row.active %}<span class="badge text-bg-secondary d-block">Inactiva</span>{% endif %}</td><td><span class="badge text-bg-info">{{ row.species }}</span> <small>{{ row.breed }}</small></td><td>{{ row.sex ?: 'No registrado' }}</td><td>{{ row.weight is not null ? row.weight~' kg' : '—' }}</td><td class="fw-semibold">{{ row.client_name }}</td><td><small>{{ row.client_phone }}<br>{{ row.client_email }}</small></td>
{% else %}<td>{{ row.license_number ?: 'No registrada' }}</td><td class="fw-semibold">{{ row.name }}</td><td><small>{{ row.email }}<br>{{ row.phone }}</small></td><td>{{ row.active ? 'Activo' : 'Inactivo' }}</td>{% endif %}
<td><div class="action-buttons"><a class="btn btn-sm btn-outline-primary" href="/fichas/{{ slug }}/{{ row.id }}">Ver ficha</a>{% if can('catalogs.write') %}<a class="btn btn-sm btn-outline-secondary" href="/catalogos/{{ slug }}/{{ row.id }}/editar">Editar</a>{% endif %}</div></td></tr>
{% else %}<tr><td colspan="8" class="text-center py-5">{{ search ? 'No hay coincidencias para esta búsqueda.' : (slug=='mascotas' ? 'Registra la primera mascota y vincúlala con su responsable.' : 'Registra el primer veterinario.') }}</td></tr>{% endfor %}</tbody></table></div>
<div class="d-flex justify-content-between mt-3"><small class="text-body-secondary">{{ total }} registros · página {{ page }}</small><div>{% if page>1 %}<a class="btn btn-sm btn-outline-secondary" href="?q={{ search|url_encode }}&page={{ page-1 }}">Anterior</a>{% endif %}{% if page*25<total %}<a class="btn btn-sm btn-outline-secondary" href="?q={{ search|url_encode }}&page={{ page+1 }}">Siguiente</a>{% endif %}</div></div>
{% endblock %}
