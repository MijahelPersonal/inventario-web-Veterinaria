{% extends 'layouts/main.html.twig' %}
{% block title %}Mi caja{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">CONTROL DE EFECTIVO</span><h1>Mi caja</h1></div></div>
{% if session %}<div class="alert alert-info">Caja #{{ session.id }} · Apertura: {{ session.opening_amount }} · Efectivo esperado: <strong>{{ expected }} {{ clinic.currency }}</strong>. Transferencias y tarjetas no aumentan el efectivo.</div>
<div class="row g-4 mb-4"><div class="col-md-6"><form class="card card-body" method="post" action="/caja/entry"><h2 class="h5">Ingreso / egreso de efectivo</h2><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ request_key }}"><label class="form-label">Tipo<select class="form-select" name="direction"><option value="in">Ingreso</option><option value="out">Egreso / retiro</option></select></label><label class="form-label">Importe<input class="form-control" name="amount" type="number" min="0.01" step="0.01" required></label><label class="form-label">Motivo<input class="form-control" name="reason" maxlength="255" required></label><button class="btn btn-outline-primary mt-2">Registrar movimiento</button></form></div>
<div class="col-md-6"><form class="card card-body" method="post" action="/caja/close"><h2 class="h5">Cerrar caja</h2><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label">Efectivo contado<input class="form-control" name="amount" type="number" min="0" step="0.01" required></label><p class="text-body-secondary">El cierre conserva el esperado, contado y diferencia. No se reabre ni se edita.</p><button class="btn btn-primary">Confirmar cierre</button></form></div></div>
{% else %}<form class="card card-body mb-4" method="post" action="/caja/open"><h2 class="h5">Abrir caja</h2><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label">Efectivo inicial<input class="form-control" name="amount" type="number" min="0" step="0.01" value="0.00" required></label><button class="btn btn-primary align-self-start mt-2">Abrir caja</button></form>{% endif %}
<div class="card mb-4"><div class="card-header">Mis últimas 30 sesiones</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>N.º</th><th>Apertura</th><th>Cierre</th><th>Esperado</th><th>Contado</th><th>Diferencia</th></tr></thead><tbody>{% for row in sessions %}<tr><td>{{ row.id }}</td><td>{{ row.opened_at }}</td><td>{{ row.closed_at ?? 'Abierta' }}</td><td>{{ row.expected_amount }}</td><td>{{ row.counted_amount }}</td><td>{{ row.difference }}</td></tr>{% else %}<tr><td colspan="6">Todavía no hay sesiones.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card"><div class="card-header">Ingresos y egresos de la caja actual</div><table class="table mb-0"><thead><tr><th>Fecha</th><th>Motivo</th><th>Importe</th></tr></thead><tbody>{% for row in entries %}<tr><td>{{ row.created_at }}</td><td>{{ row.reason }}</td><td>{{ row.amount }}</td></tr>{% else %}<tr><td colspan="3">No hay movimientos adicionales.</td></tr>{% endfor %}</tbody></table></div>
{% endblock %}
