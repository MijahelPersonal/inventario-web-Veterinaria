{% extends 'layouts/main.html.twig' %}
{% block title %}Ventas y cobros{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">VENTAS Y RECAUDACIÓN</span><h1>Ventas y cobros</h1><p class="text-body-secondary mb-0">Consulta ventas, registra pagos y controla los saldos pendientes.</p></div><div><a class="btn btn-primary" href="/tienda">Venta en tienda</a>{% if can('cash.write') %} <a class="btn btn-outline-secondary" href="#control-efectivo">Control de efectivo</a>{% endif %}</div></div>
{% if can('cash.write') %}<details class="card mb-4" id="control-efectivo"><summary class="card-header">Control de efectivo · {{ session ? 'Turno abierto' : 'Sin turno abierto' }}</summary><div class="card-body">{% include 'finance/cash-panel.html.twig' %}</div></details>{% endif %}
<div class="row g-3 mb-4"><div class="col-md-6"><div class="metric-card metric-success"><span>COBRADO NETO ACUMULADO</span><strong>{{ summary.net }} {{ clinic.currency }}</strong><small>Incluye cobros y reversiones registrados.</small></div></div><div class="col-md-6"><div class="metric-card metric-warning"><span>VENTAS Y SERVICIOS CON SALDO</span><strong>{{ summary.count }}</strong><small>Pendiente: {{ summary.balance }} {{ clinic.currency }}</small></div></div></div>
{% if can('payments.write') %}<div class="d-flex justify-content-end mb-3"><a class="btn btn-success" href="/cobros/nuevo">Registrar nuevo cobro</a></div>{% endif %}
{% if pending_sales %}<div class="card mb-4 pending-panel"><div class="card-header">Ventas y servicios pendientes de cobro</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Venta</th><th>Cliente</th><th>Origen</th><th>Saldo</th><th>Acción</th></tr></thead><tbody>{% for row in pending_sales %}<tr><td>#{{ row.id }}</td><td>{{ row.client_name ?? 'Público general' }}</td><td>{{ row.appointment_id ? 'Cita #'~row.appointment_id : 'Venta en tienda' }}</td><td class="text-danger fw-semibold">{{ row.balance }}</td><td>{% if can('payments.write') %}<a class="btn btn-success btn-sm" href="/cobros/nuevo?venta={{ row.id }}">Cobrar ahora</a>{% endif %}</td></tr>{% endfor %}</tbody></table></div></div>{% endif %}
{% if sale %}<div class="card mb-4"><div class="card-header d-flex justify-content-between"><span>Venta #{{ sale.id }} · {{ sale.status }}</span><a href="/ventas/{{ sale.id }}/ticket">Descargar ticket PDF</a></div><div class="card-body">
<p><strong>Total: {{ sale.total }} {{ clinic.currency }}</strong> · Cobrado neto: {{ paid }}</p>
{% if can('sales.void') and sale.status=='confirmed' %}<details class="mb-3"><summary>Anular venta completa</summary><form class="d-flex gap-2 mt-2" method="post" action="/ventas/{{ sale.id }}/anular"><input type="hidden" name="csrf" value="{{ csrf }}"><input class="form-control" name="reason" maxlength="255" placeholder="Motivo de anulación" required><button class="btn btn-outline-danger">Anular y devolver stock</button></form><small>Primero deben revertirse los cobros. No elimina el historial.</small></details>{% endif %}
<table class="table"><thead><tr><th>Concepto</th><th>Cantidad</th><th>Precio</th><th>Importe</th></tr></thead><tbody>{% for row in items %}<tr><td>{{ row.description }}</td><td>{{ row.quantity }}</td><td>{{ row.unit_price }}</td><td>{{ row.line_total }}</td></tr>{% endfor %}</tbody></table>
{% if can('payments.write') and sale.status=='confirmed' %}
<form class="row g-2" action="/cobros" method="post"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ payment_key }}"><input type="hidden" name="sale_id" value="{{ sale.id }}">
<div class="col-md-3"><label class="form-label">Importe aplicado<input class="form-control" name="amount" type="number" min="0.01" step="0.01" required></label></div><div class="col-md-3"><label class="form-label">Método<select class="form-select" name="method"><option value="efectivo">Efectivo</option><option value="transferencia">Transferencia</option><option value="tarjeta">Tarjeta</option></select></label></div>
<div class="col-md-4"><label class="form-label">Referencia / nota<input class="form-control" name="notes" maxlength="255"></label></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary mb-2">Cobrar</button></div></form><small class="text-body-secondary">Requiere caja abierta. Permite pagos parciales y distintos métodos, sin superar el saldo.</small>
{% endif %}</div></div>{% endif %}
{% if can('sales.write') %}
<details class="card mb-4"><summary class="card-header">Nueva venta de productos y servicios</summary><form class="card-body" method="post" action="/ventas"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ sale_key }}">
<label class="form-label">Cliente<select class="form-select mb-3" name="client_id"><option value="">Consumidor final</option>{% for row in clients %}{% if row.active %}<option value="{{ row.id }}">{{ row.name }}</option>{% endif %}{% endfor %}</select></label>
{% for index in 0..5 %}<div class="row g-2 mb-2"><div class="col-9"><select class="form-select" name="items[{{ index }}][item]" aria-label="Producto o servicio {{ index+1 }}"><option value="">Seleccionar producto o servicio</option><optgroup label="Productos">{% for row in products %}{% if row.active %}<option value="product:{{ row.id }}">{{ row.name }}</option>{% endif %}{% endfor %}</optgroup><optgroup label="Servicios">{% for row in services %}{% if row.active %}<option value="service:{{ row.id }}">{{ row.name }}</option>{% endif %}{% endfor %}</optgroup></select></div><div class="col-3"><input class="form-control" name="items[{{ index }}][quantity]" type="number" min="0.001" step="0.001" value="1" aria-label="Cantidad {{ index+1 }}"></div></div>{% endfor %}
<p class="small text-body-secondary">Los precios se obtienen del catálogo. Los lotes salen por vencimiento más próximo; un servicio no consume insumos automáticamente.</p><button class="btn btn-primary">Confirmar venta y descontar stock</button></form></details>
{% if pending %}<details class="card mb-4"><summary class="card-header">Citas confirmadas o atendidas sin cargo</summary><div class="card-body">{% for row in pending %}<form class="d-flex justify-content-between gap-2 mb-2" method="post" action="/ventas"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ sale_key }}"><input type="hidden" name="appointment_id" value="{{ row.id }}"><span>#{{ row.id }} · {{ row.pet_name }} · {{ row.service_name }} · {{ row.price }}</span><button class="btn btn-sm btn-outline-primary">Generar cargo</button></form>{% endfor %}</div></details>{% endif %}
{% endif %}
<div class="card mb-4"><div class="card-header">Últimas 100 ventas</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>N.º / fecha</th><th>Cliente</th><th>Total</th><th>Cobrado neto</th><th>Estado</th><th></th></tr></thead><tbody>
{% for row in sales %}<tr><td>#{{ row.id }} · {{ row.created_at }}</td><td>{{ row.client_name ?? 'Consumidor final' }}</td><td>{{ row.total }}</td><td>{{ row.paid }}</td><td>{{ row.status }}</td><td><a href="/ventas?venta={{ row.id }}">Ver / cobrar</a></td></tr>{% else %}<tr><td colspan="6">No hay ventas registradas.</td></tr>{% endfor %}</tbody></table></div></div>
<div class="card"><div class="card-header">Últimos 100 cobros y reversiones{{ sale ? ' de esta venta' : '' }}</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>N.º / venta</th><th>Fecha / usuario</th><th>Método</th><th>Importe</th><th>Reversión</th></tr></thead><tbody>
{% for row in payments %}<tr><td>#{{ row.id }} / #{{ row.sale_id }}</td><td>{{ row.created_at }} · {{ row.username }}</td><td>{{ row.method }}</td><td>{{ row.amount }}</td><td>{% if row.reversed %}Revertido{% elseif row.reversal_of %}Revierte #{{ row.reversal_of }}{% elseif can('payments.reverse') %}<form class="d-flex gap-2" method="post" action="/cobros/{{ row.id }}/revertir"><input type="hidden" name="csrf" value="{{ csrf }}"><input class="form-control form-control-sm" name="reason" placeholder="Motivo" maxlength="255" required><button class="btn btn-sm btn-outline-danger">Revertir</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="5">No hay cobros registrados.</td></tr>{% endfor %}</tbody></table></div></div>
{% endblock %}
