{# El control de efectivo forma parte de Ventas y cobros; no tiene sección propia. #}
{% if session %}
<div class="alert alert-info">Turno #{{ session.id }} · Efectivo inicial: {{ session.opening_amount }} · Esperado: <strong>{{ expected }} {{ clinic.currency }}</strong>. Tarjetas y transferencias no aumentan el efectivo.</div>
<div class="row g-3"><div class="col-md-6"><form method="post" action="/ventas/efectivo/entry">
<input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ request_key }}">
<label class="form-label">Movimiento<select class="form-select" name="direction"><option value="in">Otro ingreso</option><option value="out">Egreso / retiro</option></select></label>
<label class="form-label">Importe<input class="form-control" name="amount" type="number" min="0.01" step="0.01" required></label><label class="form-label">Motivo<input class="form-control" name="reason" maxlength="255" required></label><button class="btn btn-outline-primary">Registrar</button>
</form></div><div class="col-md-6"><form method="post" action="/ventas/efectivo/close"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label">Efectivo contado al cerrar<input class="form-control" name="amount" type="number" min="0" step="0.01" required></label><button class="btn btn-primary">Cerrar turno</button></form><small>Se conservarán el esperado, contado y diferencia.</small></div></div>
{% else %}<form class="d-flex gap-2 align-items-end" method="post" action="/ventas/efectivo/open"><input type="hidden" name="csrf" value="{{ csrf }}"><label class="form-label mb-0">Efectivo inicial<input class="form-control" name="amount" type="number" min="0" step="0.01" value="0.00" required></label><button class="btn btn-primary">Iniciar turno de cobros</button></form>{% endif %}
<div class="table-responsive mt-4"><table class="table table-sm"><thead><tr><th>Turno</th><th>Apertura</th><th>Cierre</th><th>Esperado</th><th>Contado</th><th>Diferencia</th></tr></thead><tbody>{% for row in sessions %}<tr><td>{{ row.id }}</td><td>{{ row.opened_at }}</td><td>{{ row.closed_at ?? 'Abierto' }}</td><td>{{ row.expected_amount }}</td><td>{{ row.counted_amount }}</td><td>{{ row.difference }}</td></tr>{% else %}<tr><td colspan="6">Sin turnos registrados.</td></tr>{% endfor %}</tbody></table></div>
{% if entries %}<h3 class="h6">Otros movimientos del turno actual</h3><ul>{% for row in entries %}<li>{{ row.created_at }} · {{ row.reason }} · {{ row.amount }}</li>{% endfor %}</ul>{% endif %}
