{% extends 'layouts/main.html.twig' %}
{% block title %}Registrar cobro{% endblock %}
{% block content %}
<div class="page-heading"><div><h1>Registrar cobro</h1><p class="text-body-secondary mb-0">Aplica un pago a una venta o servicio con saldo pendiente.</p></div><a class="btn btn-outline-secondary" href="/ventas">Volver a ventas y cobros</a></div>
{% if not session %}<div class="alert alert-warning">Primero <a href="/ventas#control-efectivo">inicia un turno de cobros</a> indicando tu efectivo inicial.</div>{% endif %}
<form class="card card-body" method="post" action="/cobros"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="request_key" value="{{ request_key }}">
<label class="form-label" for="sale_id">Selecciona una venta o servicio pendiente *</label><select class="form-select mb-4" id="sale_id" name="sale_id" required data-payment-sale><option value="">Seleccionar venta con saldo</option>{% for row in pending_sales %}<option value="{{ row.id }}" data-balance="{{ row.balance }}" {{ row.id==selected ? 'selected' : '' }}>#{{ row.id }} · {{ row.client_name ?? 'Público general' }} · {{ row.appointment_id ? 'Cita #'~row.appointment_id : 'Venta en tienda' }} · Saldo {{ row.balance }} {{ clinic.currency }}</option>{% endfor %}</select>
<div class="row g-3"><div class="col-md-6"><label class="form-label" for="amount">Monto a cobrar *</label><input class="form-control" id="amount" name="amount" type="number" min="0.01" step="0.01" required></div><div class="col-md-6"><label class="form-label" for="method">Método de pago *</label><select class="form-select" id="method" name="method"><option value="efectivo">Efectivo</option><option value="transferencia">Transferencia</option><option value="tarjeta">Tarjeta</option></select></div><div class="col-12"><label class="form-label" for="notes">Referencia o nota de la transacción</label><input class="form-control" id="notes" name="notes" maxlength="255" placeholder="Número de operación o referencia del pago"></div></div>
<p class="text-body-secondary small mt-3">Se admiten pagos parciales. Registrar el pago no cambia el estado de atención de la cita.</p><div class="d-flex justify-content-end gap-2 mt-3"><a class="btn btn-outline-secondary" href="/ventas">Cancelar</a><button class="btn btn-success" {{ not session ? 'disabled' : '' }}>Registrar pago</button></div></form>
{% endblock %}
