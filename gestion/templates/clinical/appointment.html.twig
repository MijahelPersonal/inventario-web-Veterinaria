{% extends 'layouts/main.html.twig' %}
{% block title %}Cita #{{ record.id }}{% endblock %}
{% block content %}
<div class="page-heading"><div><span class="eyebrow">ATENCIÓN VETERINARIA</span><h1>Cita #{{ record.id }}</h1></div><a href="/citas" class="btn btn-outline-primary">Volver a la agenda</a></div>
<div class="card card-body mb-4"><h2 class="h5">{{ record.pet_name }} · {{ record.service_name }}</h2><p>Responsable: {{ record.client_name }} · {{ record.client_phone }}</p><p>Veterinario: {{ record.veterinarian_name }} · {{ record.start_at }} a {{ record.end_at|date('H:i') }}</p><p>Estado: {{ attribute(states,record.status) }} · Precio histórico: {{ record.price }} {{ clinic.currency }}</p><p>Origen: {{ record.source }} · Notas administrativas: {{ record.notes }}</p></div>
{% if can('appointments.write') and record.status in ['solicitada','confirmada'] %}<details class="card mb-4"><summary class="card-header">Reprogramar</summary><form class="card-body row g-3" method="post" action="/citas/{{ record.id }}/reprogramar"><input type="hidden" name="csrf" value="{{ csrf }}"><div class="col-md-5"><label class="form-label">Veterinario<select class="form-select" name="veterinarian_id" required>{% for row in veterinarians %}{% if row.active %}<option value="{{ row.id }}" {{ row.id==record.veterinarian_id ? 'selected' : '' }}>{{ row.name }}</option>{% endif %}{% endfor %}</select></label></div><div class="col-md-5"><label class="form-label">Nueva fecha y hora<input class="form-control" type="datetime-local" name="start_at" required></label></div><div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary mb-2">Reprogramar</button></div><p class="small text-body-secondary">Conserva servicio, duración y precio histórico. Si tiene cargo, anúlalo antes de reprogramar.</p></form></details>{% endif %}
{% if can('clinical.read') %}
<div class="card card-body mb-4"><h2 class="h5">Registro de atención</h2><p><strong>Síntomas:</strong> {{ record.symptoms ?? 'Sin registro' }}</p><p><strong>Diagnóstico:</strong> {{ record.diagnosis ?? 'Sin registro' }}</p><p><strong>Indicaciones / tratamiento:</strong> {{ record.treatment ?? 'Sin registro' }}</p><a href="/citas/{{ record.id }}/pdf">Descargar constancia PDF de atención</a></div>
{% endif %}
{% if can('clinical.write') %}<form class="card card-body" action="/citas/{{ record.id }}/notas" method="post"><h2 class="h5">Actualizar notas de atención</h2><input type="hidden" name="csrf" value="{{ csrf }}">{% for key,label in {'symptoms':'Síntomas','diagnosis':'Diagnóstico','treatment':'Indicaciones y tratamiento'} %}<label class="form-label mt-2" for="{{ key }}">{{ label }}</label><textarea class="form-control" id="{{ key }}" name="{{ key }}" rows="3" maxlength="5000">{{ attribute(record,key) }}</textarea>{% endfor %}<button class="btn btn-primary align-self-start mt-3">Guardar notas</button></form>{% endif %}
{% endblock %}
