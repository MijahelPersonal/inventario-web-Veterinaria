{# Un solo menú compartido evita accesos repetidos o pantallas independientes de caja. #}
<nav aria-label="Navegación principal">
{% for group in navigation %}
    {% if group.collapsed|default(false) %}<details class="more-catalogs"><summary>{{ group.label }}</summary>{% elseif group.label %}<div class="nav-label">{{ group.label }}</div>{% endif %}
    {% for link in group.links %}
        {% if link[3] is null or can(link[3]) %}
        <a class="nav-item {{ current_path==link[1] or (link[1]!='/' and current_path starts with link[1]~'/') ? 'active' : '' }}" href="{{ link[1] }}"><span aria-hidden="true">{{ link[2] }}</span>{{ link[0] }}</a>
        {% endif %}
    {% endfor %}
    {% if group.collapsed|default(false) %}</details>{% endif %}
{% endfor %}
</nav>
