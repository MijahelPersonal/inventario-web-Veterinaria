<!doctype html>
<html lang="es" data-coreui-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Gestión{% endblock %} · {{ app_name }}</title>
    <link rel="stylesheet" href="/assets/vendor/coreui.min.css">
    <link rel="stylesheet" href="/assets/css/app.css">
    <link rel="stylesheet" href="/assets/css/shell.css">
    <link rel="stylesheet" href="/assets/css/store.css">
</head>
<body class="{{ current_user ? 'authenticated' : 'guest' }}" style="--brand: {{ clinic.primary_color|default('#2563eb') }}">
    <header class="header px-4">
    {% if current_user %}<div class="header-caption"><button type="button" id="sidebar-toggle" aria-label="Mostrar u ocultar menú" aria-expanded="true">☰</button><span>Sistema interno de operaciones</span></div>{% else %}<a class="header-brand text-decoration-none" href="/">{{ app_name }}</a>{% endif %}
    <div class="d-flex gap-3 align-items-center"><button class="btn btn-sm btn-outline-secondary" type="button" id="theme-toggle">Claro / oscuro</button>
    {% if current_user %}<span class="header-status">{{ clinic.currency|default('PEN') }} · <span class="status-dot"></span> Gestión veterinaria</span>{% endif %}</div></header>
    <div class="app-layout {{ not current_user ? 'guest' : '' }}">
    {% if current_user %}<aside class="app-sidebar" id="main-sidebar">
    <a class="sidebar-brand" href="/"><span class="brand-mark">SV</span><span><strong>{{ app_name }}</strong><small>INVENTARIO & VETERINARIA</small></span></a>
    <nav aria-label="Navegación principal"><a class="nav-item {{ current_path=='/' ? 'active' : '' }}" href="/"><span aria-hidden="true">⌂</span> Inicio</a>
    {% if can('sales.write') %}<a class="nav-item {{ current_path=='/tienda' ? 'active' : '' }}" href="/tienda"><span aria-hidden="true">＋</span> Venta en tienda</a>{% endif %}
    {% if can('catalogs.read') %}
    <a class="nav-item {{ current_path starts with '/catalogos/productos' ? 'active' : '' }}" href="/catalogos/productos"><span aria-hidden="true">▦</span> Productos</a>
    <a class="nav-item {{ current_path starts with '/catalogos/clientes' ? 'active' : '' }}" href="/catalogos/clientes"><span aria-hidden="true">♙</span> Clientes</a>
    {% endif %}
    <div class="nav-label">OPERACIONES</div>
    {% if can('sales.read') %}<a class="nav-item {{ current_path starts with '/ventas' ? 'active' : '' }}" href="/ventas"><span aria-hidden="true">≡</span> Ventas y cobros</a>{% endif %}
    {% if can('cash.write') %}<a class="nav-item {{ current_path=='/caja' ? 'active' : '' }}" href="/caja"><span aria-hidden="true">▣</span> Mi caja</a>{% endif %}
    {% if can('inventory.read') %}<a class="nav-item {{ current_path starts with '/inventario' ? 'active' : '' }}" href="/inventario"><span aria-hidden="true">▤</span> Inventario</a>{% endif %}
    {% if can('appointments.read') %}<a class="nav-item {{ current_path starts with '/citas' ? 'active' : '' }}" href="/citas"><span aria-hidden="true">▦</span> Agenda de citas</a>{% endif %}
    {% if can('catalogs.read') %}<details class="more-catalogs"><summary>Más catálogos</summary>{% for slug,catalog in catalogs %}{% if slug not in ['productos','clientes'] %}<a class="nav-item {{ current_path starts with '/catalogos/'~slug ? 'active' : '' }}" href="/catalogos/{{ slug }}">{{ catalog.title }}</a>{% endif %}{% endfor %}</details>{% endif %}
    {% if can('users.manage') %}<a class="nav-item" href="/usuarios">Personal y permisos</a>{% endif %}
    {% if can('settings.manage') %}<a class="nav-item" href="/configuracion">Configuración</a>{% endif %}
    {% if can('audit.read') %}<a class="nav-item" href="/auditoria">Auditoría</a>{% endif %}
    {% block module_navigation %}{% endblock %}
    </nav><div class="sidebar-footer"><div class="sidebar-user"><span class="avatar-letter">{{ current_user.name|first|upper }}</span><div><strong>{{ current_user.username }}</strong><small>PERSONAL AUTORIZADO</small></div></div><form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="sidebar-logout">↪ Cerrar sesión</button></form></div></aside>{% endif %}
    <main class="workspace">{% if flash %}<div role="alert" class="alert alert-{{ flash.type }}">{{ flash.message }}</div>{% endif %}{% block content %}{% endblock %}</main></div>
    <script src="/assets/vendor/coreui.bundle.min.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
