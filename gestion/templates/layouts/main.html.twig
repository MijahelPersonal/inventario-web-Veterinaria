<!doctype html>
<html lang="es" data-coreui-theme="light">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Gestión{% endblock %} · {{ app_name }}</title>
    <link rel="stylesheet" href="/assets/vendor/coreui.min.css">
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body>
    <header class="header px-4"><a class="header-brand text-decoration-none" href="/">{{ app_name }}</a>
    {% if current_user %}<div class="d-flex gap-3 align-items-center"><span>{{ current_user.name }}</span><form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn btn-outline-secondary btn-sm">Cerrar sesión</button></form></div>{% else %}<span>Gestión administrativa</span>{% endif %}</header>
    <main class="container py-5">{% if flash %}<div role="alert" class="alert alert-{{ flash.type }}">{{ flash.message }}</div>{% endif %}{% block content %}{% endblock %}</main>
    <script src="/assets/vendor/coreui.bundle.min.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
</body>
</html>
