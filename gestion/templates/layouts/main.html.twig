<!doctype html>
<html lang="es" data-coreui-theme="{{ clinic.theme|default('light') }}">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Gestión{% endblock %} · {{ app_name }}</title>
    <link rel="stylesheet" href="/assets/vendor/coreui.min.css">
    <link rel="stylesheet" href="/assets/js/app.css">
    <link rel="stylesheet" href="/assets/css/app.css">
    <link rel="stylesheet" href="/assets/css/shell.css">
    <link rel="stylesheet" href="/assets/css/store.css">
</head>
<body class="{{ current_user ? 'authenticated' : 'guest' }}" style="--brand: {{ clinic.primary_color|default('#2563eb') }}">
    <header class="header px-4">
    {% if current_user %}<div class="header-caption"><button type="button" id="sidebar-toggle" aria-label="Mostrar u ocultar menú" aria-expanded="true">☰</button><span>Sistema de gestión veterinaria</span></div>{% else %}<a class="header-brand text-decoration-none" href="/">{{ app_name }}</a>{% endif %}
    <div class="d-flex gap-3 align-items-center">
    {% if current_user %}<span class="header-status">{{ clinic.currency|default('PEN') }} · <span class="status-dot"></span> Gestión veterinaria</span>{% endif %}</div></header>
    <div class="app-layout {{ not current_user ? 'guest' : '' }}">
    {% if current_user %}<aside class="app-sidebar" id="main-sidebar">
    <a class="sidebar-brand" href="/"><span class="brand-heart"><i class="bi bi-heart-pulse-fill" aria-hidden="true"></i></span><span><strong>STRUCH VET</strong><small>SISTEMA DE GESTIÓN VETERINARIA</small></span></a>
    {% include "layouts/navigation.html.twig" %}<div class="sidebar-footer"><div class="sidebar-user"><span class="avatar-letter">{{ current_user.name|first|upper }}</span><div><strong>{{ current_user.username }}</strong><small>PERSONAL AUTORIZADO</small></div></div><form method="post" action="/logout"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="sidebar-logout">↪ Cerrar sesión</button></form></div></aside>{% endif %}
    <main class="workspace"><div class="workspace-content">{% if flash %}<div role="alert" class="alert alert-{{ flash.type }}">{{ flash.message }}</div>{% endif %}{% block content %}{% endblock %}</div><footer class="system-footer"><span><i class="bi bi-heart-pulse-fill" aria-hidden="true"></i> STRUCH VET · © {{ "now"|date("Y") }} · Creado por <strong>{{ system_creator }}</strong></span><span>Sistema de gestión veterinaria · v{{ system_version }}</span></footer></main></div>
    <script src="/assets/vendor/coreui.bundle.min.js" defer></script>
    <script src="/assets/js/app.js" defer></script>
    {% block scripts %}{% endblock %}
</body>
</html>
