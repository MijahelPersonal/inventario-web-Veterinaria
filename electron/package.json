{
  "name": "struchvet-desktop",
  "version": "0.3.0",
  "description": "Gestión veterinaria StruchVet con PHP integrado",
  "main": "src/main/index.cjs",
  "author": {
    "name": "MijahelPersonal",
    "email": "mijahelrojaspersonal@gmail.com"
  },
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/MijahelPersonal/inventario-web-Veterinaria",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "prepare:resources": "node scripts/prepare-resources.cjs",
    "verify:resources": "node scripts/verify-resources.cjs",
    "icons": "python3 scripts/prepare-icons.py",
    "build:linux": "electron-builder --linux AppImage rpm deb --publish never",
    "build:win": "electron-builder --win nsis --publish never",
    "build:mac": "electron-builder --mac dmg zip --publish never",
    "build:dir": "electron-builder --dir --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.15.3"
  },
  "desktopName": "struchvet-desktop.desktop"
}
