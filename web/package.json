  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "^6.0.3"
  }
