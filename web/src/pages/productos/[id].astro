---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Icon from '../../components/Icon.astro';
import ProductCard from '../../components/ProductCard.astro';
import { getCatalog, money } from '../../lib/backend';
const catalog = await getCatalog();
const product = catalog.products.find((p) => String(p.id) === Astro.params.id);
if (!product) Astro.response.status = 404;
const related = product
  ? catalog.products
      .filter((p) => p.id !== product.id && p.category === product.category)
      .slice(0, 4)
  : [];
---

<SiteLayout title={product?.name || 'Producto no encontrado'}>
  {product ? (
    <>
      <section class="wrap section product-page">
        <a class="breadcrumb" href="/tienda">
          Tienda{' '}
          <span>
            / {product.category || 'Productos'} / {product.name}
          </span>
        </a>
        <div class="product-detail">
          <div class="detail-photo">
            {product.image ? (
              <img
                src={'/api/productos/' + product.id}
                alt={product.name}
                width="800"
                height="800"
                fetchpriority="high"
              />
            ) : (
              <span class="no-product-image">
                <Icon name="bag" size={90} />
                <small>Fotografía por agregar</small>
              </span>
            )}
          </div>
          <div class="detail-info">
            <span class="eyebrow">{product.brand || 'SELECCIÓN STRUCHVET'}</span>
            <h1>{product.name}</h1>
            <p class="muted">{product.presentation || product.category}</p>
            {product.demo && <p class="muted">Producto de prueba: precio y existencias simulados.</p>}
            <span class:list={['stock-note', { 'out-of-stock': Number(product.available) < 1 }]}>
              <span class="live-dot"></span>
              {Number(product.available) >= 1
                ? 'Disponible para solicitar'
                : 'Temporalmente agotado'}
            </span>
            <div class="detail-price">
              {product.on_sale && (
                <div class="detail-saving">
                  <del>{money(product.regular_price || product.price)}</del>
                  <span>
                    {product.discount_percent ? `-${product.discount_percent}%` : 'Oferta'}
                  </span>
                </div>
              )}
              {money(product.price)}
            </div>
            <p class="detail-description">
              {product.description ||
                'Conversa con nuestro equipo para conocer los detalles y elegir lo mejor para tu compañero.'}
            </p>
            <button
              class="button button-green add-to-cart"
              data-product={JSON.stringify(product)}
              disabled={Number(product.available) < 1}
            >
              Agregar a mi carrito <Icon name="bag" size={20} />
            </button>
            <a class="text-link" href="/carrito">
              Ver mi carrito <Icon name="arrow" size={17} />
            </a>
            <div class="detail-assurances">
              <span>
                <Icon name="shield" size={21} /> Disponibilidad revisada al coordinar
              </span>
              <span>
                <Icon name="mail" size={21} /> Te acompañamos con tu pedido
              </span>
            </div>
            <details class="detail-accordion" open>
              <summary>
                Información del producto <Icon name="chevron" size={18} />
              </summary>
              <dl>
                <div>
                  <dt>Código</dt>
                  <dd>{product.code}</dd>
                </div>
                {product.brand && (
                  <div>
                    <dt>Marca</dt>
                    <dd>{product.brand}</dd>
                  </div>
                )}
                {product.presentation && (
                  <div>
                    <dt>Presentación</dt>
                    <dd>{product.presentation}</dd>
                  </div>
                )}
              </dl>
            </details>
            <details class="detail-accordion">
              <summary>
                ¿Cómo solicito mi compra? <Icon name="chevron" size={18} />
              </summary>
              <p>
                Agrégalo al carrito y completa tus datos. El equipo confirmará existencias, entrega
                y pago. No se realizan cobros en la web.
              </p>
            </details>
            <a class="text-link" href="/contacto">
              Tengo una consulta sobre este producto <Icon name="arrow" size={16} />
            </a>
          </div>
        </div>
      </section>
      {related.length > 0 && (
        <section class="wrap section">
          <div class="section-heading">
            <div>
              <span class="eyebrow">TAMBIÉN PODRÍA GUSTARLE</span>
              <h2>Más para su día a día.</h2>
            </div>
          </div>
          <div class="home-product-grid">
            {related.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </section>
      )}
    </>
  ) : (
    <section class="wrap section empty-state">
      <Icon name="search" size={44} />
      <h1>No encontramos este producto.</h1>
      <p>Puede haber sido retirado o el enlace ya no está disponible.</p>
      <a href="/tienda" class="button button-green">
        Explorar la tienda
      </a>
    </section>
  )}
</SiteLayout>
