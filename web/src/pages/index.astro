---
import SiteLayout from '../layouts/SiteLayout.astro';
import Icon from '../components/Icon.astro';
import ProductSection from '../components/ProductSection.astro';
import { getCatalog } from '../lib/backend';
import { matchesCategory } from '../lib/categories';
const catalog = await getCatalog();
const offers = catalog.products.filter((p) => p.on_sale);
const brands = [...new Set(catalog.products.map((p) => p.brand).filter(Boolean))].slice(0, 10);
const campaigns = [
  {
    title: 'Alimento para perros',
    text: 'Encuentra su próximo favorito.',
    url: '/perros?grupo=alimentos',
    image: '/images/alimentacion.jpg',
    color: 'orange',
  },
  {
    title: 'Todo para tu gato',
    text: 'Alimentos, cuidado y accesorios.',
    url: '/gatos',
    image: '/images/gato-v2.webp',
    color: 'mint',
  },
  {
    title: 'Antiparasitarios',
    text: 'Consulta la opción para tu mascota.',
    url: '/antiparasitarios',
    image: '/images/farmacia.jpg',
    color: 'blue',
  },
  {
    title: 'Accesorios y juguetes',
    text: 'Pequeños detalles para su día.',
    url: '/accesorios',
    image: '/images/accesorios.jpg',
    color: 'yellow',
  },
];
const slides = [
  {
    tag: 'SU TIENDA VETERINARIA ONLINE',
    title: 'Lo que necesita.',
    accent: 'Lo que más le gusta.',
    text: 'Alimentos, accesorios y cuidados para perros y gatos.',
    image: '/images/banner-nutricion.jpg',
    url: '/tienda',
    cta: 'Comprar ahora',
    theme: 'royal',
  },
  {
    tag: 'UN MUNDO PARA TU GATO',
    title: 'Sus favoritos,',
    accent: 'a un solo clic.',
    text: 'Descubre alimento, snacks y accesorios para su día a día.',
    image: '/images/banner-gatos.jpg',
    url: '/gatos',
    cta: 'Ver para gatos',
    theme: 'gold',
  },
  {
    tag: 'CUIDADO EN CADA DETALLE',
    title: 'Listos para',
    accent: 'otra aventura.',
    text: 'Equipa sus paseos, sus juegos y sus mejores momentos.',
    image: '/images/banner-cuidado.jpg',
    url: '/accesorios',
    cta: 'Ver accesorios',
    theme: 'navy',
  },
];
---

<SiteLayout title="Tienda online para perros y gatos">
  <section
    class="retail-carousel"
    data-carousel
    aria-label="Campañas de StruchVet"
    aria-roledescription="carrusel"
  >
    <div class="slides">
      {slides.map((slide, i) => (
        <article
          class={'retail-slide retail-slide-' + slide.theme}
          data-slide
          hidden={i !== 0}
          aria-label={'Campaña ' + (i + 1) + ' de 3'}
        >
          <img
            class="retail-banner-image"
            src={slide.image}
            alt={
              i === 0
                ? 'Perro y alimento en una composición comercial'
                : i === 1
                  ? 'Gato y accesorios para su cuidado'
                  : 'Accesorios para mascotas en un estudio azul'
            }
            width="1920"
            height="640"
            fetchpriority={i === 0 ? 'high' : 'auto'}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
          <div class="wrap retail-slide-content">
            <span>{slide.tag}</span>
            <h1>
              {slide.title}
              <br />
              <strong>{slide.accent}</strong>
            </h1>
            <p>{slide.text}</p>
            <a class="retail-buy-button" href={slide.url}>
              {slide.cta}
              <Icon name="arrow" size={24} />
            </a>
          </div>
        </article>
      ))}
    </div>
    <button class="retail-carousel-prev" data-slide-prev aria-label="Campaña anterior">
      ‹
    </button>
    <button class="retail-carousel-next" data-slide-next aria-label="Siguiente campaña">
      ›
    </button>
    <div class="retail-carousel-dots">
      {slides.map((_, i) => (
        <button
          data-slide-to={i}
          aria-label={'Ver campaña ' + (i + 1)}
          aria-pressed={i === 0}
        ></button>
      ))}
      <span data-slide-counter aria-live="polite">
        01 / 03
      </span>
    </div>
  </section>
  <section class="retail-benefits">
    <div class="wrap">
      <div>
        <Icon name="bag" size={30} />
        <span>
          <strong>Compra sin crear una cuenta</strong>
          <small>Elige y solicita tu pedido.</small>
        </span>
      </div>
      <div>
        <Icon name="shield" size={30} />
        <span>
          <strong>Disponibilidad verificada</strong>
          <small>Existencias revisadas al solicitar.</small>
        </span>
      </div>
      <div>
        <Icon name="phone" size={30} />
        <span>
          <strong>Atención para tu compra</strong>
          <small>Coordinamos entrega y pago contigo.</small>
        </span>
      </div>
    </div>
  </section>
  <ProductSection
    title="¡Ofertas para consentirlos!"
    url="/ofertas"
    products={offers}
    label="Precios especiales vigentes"
  />
  <section class="wrap retail-section">
    <div class="retail-section-heading">
      <h2>{offers.length ? 'Compra por categoría' : 'Encuentra lo que necesita tu mascota'}</h2>
      <a href="/tienda">
        Ver toda la tienda <Icon name="arrow" size={20} />
      </a>
    </div>
    <div class="campaign-grid">
      {campaigns.map((item) => (
        <a class={'campaign-card campaign-' + item.color} href={item.url}>
          <img src={item.image} alt={item.title} width="600" height="400" loading="lazy" />
          <div>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <span>
              Ver productos <Icon name="arrow" size={19} />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
  <ProductSection title="Productos destacados" url="/tienda" products={catalog.products} />
  {!catalog.products.length && (
    <section class="wrap retail-catalog-status">
      <Icon name="bag" size={30} />
      <div>
        <h2>
          {catalog.connected
            ? 'El catálogo se está preparando.'
            : 'No pudimos cargar los productos.'}
        </h2>
        <p>
          {catalog.connected
            ? 'Estamos organizando nuestra selección de productos. Consúltanos por lo que necesitas.'
            : 'Vuelve a intentarlo o escríbenos para ayudarte con tu compra.'}
        </p>
      </div>
      <a class="button button-green" href="/contacto">
        Consultar un producto <Icon name="arrow" size={20} />
      </a>
    </section>
  )}
  <section class="wrap retail-duo">
    <a href="/alimentos" class="retail-mini-banner">
      <img
        src="/images/alimentacion.jpg"
        alt="Alimento y plato para mascotas"
        width="1200"
        height="800"
        loading="lazy"
      />
      <div>
        <span>ALIMENTOS Y NUTRICIÓN</span>
        <h2>
          Su mejor día
          <br />
          empieza en el plato.
        </h2>
        <strong>
          Explorar alimentos <Icon name="arrow" size={20} />
        </strong>
      </div>
    </a>
    <a href="/accesorios" class="retail-mini-banner retail-mini-blue">
      <img
        src="/images/accesorios.jpg"
        alt="Arnés, juguetes y cepillo para mascotas"
        width="1200"
        height="800"
        loading="lazy"
      />
      <div>
        <span>ACCESORIOS Y CUIDADO</span>
        <h2>
          Más juegos.
          <br />
          Más momentos juntos.
        </h2>
        <strong>
          Descubrir accesorios <Icon name="arrow" size={20} />
        </strong>
      </div>
    </a>
  </section>
  <ProductSection
    title="Alimentos para perros"
    url="/perros?grupo=alimentos"
    products={catalog.products.filter(
      (p) => matchesCategory(p, 'perros') && matchesCategory(p, 'alimentos'),
    )}
  />
  <ProductSection
    title="Alimentos para gatos"
    url="/gatos?grupo=alimentos"
    products={catalog.products.filter(
      (p) => matchesCategory(p, 'gatos') && matchesCategory(p, 'alimentos'),
    )}
  />
  <section class="retail-wide-campaign">
    <div class="wrap">
      <div>
        <span>FARMACIA VETERINARIA</span>
        <h2>
          Una buena elección
          <br />
          empieza con orientación.
        </h2>
        <p>Explora nuestros productos y consulta al equipo.</p>
        <a class="retail-buy-button" href="/farmacia">
          Ver farmacia <Icon name="arrow" size={22} />
        </a>
      </div>
      <img
        src="/images/farmacia.jpg"
        alt="Cachorro y gatito durante una revisión ilustrativa"
        width="1200"
        height="800"
        loading="lazy"
      />
    </div>
  </section>
  <ProductSection
    title="Farmacia y antiparasitarios"
    url="/farmacia"
    products={catalog.products.filter((p) => matchesCategory(p, 'farmacia'))}
  />
  <ProductSection
    title="Accesorios para su día a día"
    url="/accesorios"
    products={catalog.products.filter((p) => matchesCategory(p, 'accesorios'))}
  />
  {brands.length > 0 && (
    <section class="wrap retail-section">
      <div class="retail-section-heading">
        <h2>Las marcas de nuestra tienda</h2>
        <a href="/marcas">
          Ver marcas <Icon name="arrow" size={20} />
        </a>
      </div>
      <div class="retail-brand-rail">
        {brands.map((brand) => (
          <a href={'/tienda?marca=' + encodeURIComponent(brand)}>{brand}</a>
        ))}
      </div>
    </section>
  )}
  <section class="wrap retail-help-links">
    <a href="/servicios">
      <Icon name="stethoscope" size={35} />
      <div>
        <h3>Atención veterinaria</h3>
        <p>Conoce nuestros servicios.</p>
      </div>
      <Icon name="arrow" size={22} />
    </a>
    <a href="/citas">
      <Icon name="calendar" size={35} />
      <div>
        <h3>Solicita una cita</h3>
        <p>Coordinemos su próxima visita.</p>
      </div>
      <Icon name="arrow" size={22} />
    </a>
    <a href="/contacto">
      <Icon name="mail" size={35} />
      <div>
        <h3>¿Te ayudamos a elegir?</h3>
        <p>Estamos para acompañarte.</p>
      </div>
      <Icon name="arrow" size={22} />
    </a>
  </section>
</SiteLayout>
