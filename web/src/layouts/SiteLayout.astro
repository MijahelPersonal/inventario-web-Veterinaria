---
import '@fontsource-variable/manrope';
import '@fontsource-variable/dm-sans';
import '../styles/site.css';
import Icon from '../components/Icon.astro';
interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'El bienestar de tu mascota, en un solo lugar',
  description = 'StrukVet: productos para mascotas y atención veterinaria cercana. Descubre nuestro catálogo y solicita una cita.',
} = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { label: 'Inicio', url: '/' },
  { label: 'Tienda', url: '/tienda' },
  { label: 'Servicios veterinarios', url: '/servicios' },
  { label: 'Nosotros', url: '/nosotros' },
  { label: 'Contacto', url: '/contacto' },
];
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#234d42" />
    <title>{title} · StrukVet</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <a class="skip-link" href="#contenido">
      Saltar al contenido
    </a>
    <div class="announcement">
      <span>
        <Icon name="heart" size={13} /> Pequeños compañeros. Grandes cuidados.
      </span>
      <a href="/citas">
        Un momento para su bienestar <span aria-hidden="true">↗</span>
      </a>
    </div>
    <header class="site-header">
      <div class="header-main wrap">
        <a class="logo" href="/" aria-label="StrukVet, inicio">
          <span class="logo-mark">
            <Icon name="paw" size={25} />
          </span>
          <span>
            Struk<span class="logo-light">Vet</span>
            <span class="logo-dot">.</span>
          </span>
        </a>
        <form class="search-box" action="/tienda" role="search">
          <Icon name="search" size={20} />
          <input
            type="search"
            name="q"
            placeholder="¿Qué necesita tu mejor amigo?"
            aria-label="Buscar productos"
            autocomplete="off"
          />
          <button type="submit" aria-label="Buscar">
            <Icon name="arrow" size={18} />
          </button>
        </form>
        <div class="header-actions">
          <a class="appointment-top" href="/citas">
            <Icon name="calendar" size={19} />
            <span>Agenda una cita</span>
          </a>
          <a class="cart-link" href="/carrito" aria-label="Ver carrito">
            <Icon name="bag" size={23} />
            <span data-cart-count>0</span>
          </a>
          <button
            id="menu-toggle"
            class="icon-button mobile-menu"
            aria-label="Abrir menú"
            aria-expanded="false"
          >
            <Icon name="menu" />
          </button>
        </div>
      </div>
      <div class="nav-border">
        <nav class="main-nav wrap" id="main-nav" aria-label="Navegación principal">
          <div class="nav-links">
            {nav.map((item) => (
              <a
                href={item.url}
                class:list={{ active: path === item.url }}
                aria-current={path === item.url ? 'page' : undefined}
              >
                {item.label}
                {item.url === '/tienda' && <Icon name="chevron" size={13} />}
              </a>
            ))}
          </div>
          <a href="/tienda?categoria=bienestar" class="nav-note">
            <Icon name="leaf" size={16} /> Todo para una vida más feliz
          </a>
        </nav>
      </div>
    </header>
    <main id="contenido">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap footer-top">
        <div class="footer-brand">
          <a class="logo" href="/">
            <span class="logo-mark">
              <Icon name="paw" size={25} />
            </span>
            <span>
              Struk<span class="logo-light">Vet</span>
              <span class="logo-dot">.</span>
            </span>
          </a>
          <p>
            Cuidamos a quienes hacen
            <br />
            tu vida más bonita.
          </p>
          <span class="footer-small">Productos, cuidado y mucho cariño.</span>
        </div>
        <div>
          <h3>Explora</h3>
          <a href="/tienda">Tienda para mascotas</a>
          <a href="/servicios">Nuestros servicios</a>
          <a href="/nosotros">Conoce StrukVet</a>
        </div>
        <div>
          <h3>Estamos para ayudarte</h3>
          <a href="/citas">Solicitar una cita</a>
          <a href="/contacto">Habla con nosotros</a>
          <a href="/carrito">Mi carrito</a>
        </div>
        <div class="footer-letter">
          <span class="mini-label">UNA VIDA JUNTOS</span>
          <h3>
            Ellos ponen el amor.
            <br />
            Nosotros, los cuidados.
          </h3>
          <Icon name="heart" size={30} />
        </div>
      </div>
      <div class="wrap footer-bottom">
        <span>
          © {new Date().getFullYear()} StrukVet. Creado por <strong>MijxhelDev</strong>.
        </span>
        <a href="/privacidad">Privacidad y condiciones</a>
        <span>
          Hecho para los que dejan huella <Icon name="paw" size={13} />
        </span>
      </div>
    </footer>
    <div class="toast" id="toast" role="status" aria-live="polite" hidden></div>
    <script>
      import '../scripts/site';
    </script>
  </body>
</html>
