---
import ProductCard from './ProductCard.astro';
import Icon from './Icon.astro';
import type { Product } from '../lib/types';
interface Props {
  title: string;
  url: string;
  products: Product[];
  label?: string;
}
const { title, url, products, label } = Astro.props;
---

{products.length > 0 && (
  <section class="wrap retail-section">
    <div class="retail-section-heading">
      <h2>{title}</h2>
      {label && <span>{label}</span>}
      <a href={url}>
        Ver todos <Icon name="arrow" size={20} />
      </a>
    </div>
    <div class="retail-product-grid">
      {products.slice(0, 4).map((product) => (
        <ProductCard product={product} />
      ))}
    </div>
  </section>
)}
