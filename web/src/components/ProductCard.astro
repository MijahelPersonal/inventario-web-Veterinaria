---
import Icon from './Icon.astro';
import { money } from '../lib/backend';
import type { Product } from '../lib/types';
interface Props {
  product: Product;
}
const { product } = Astro.props;
const available = Math.floor(Number(product.available));
---

<article class="product-card">
  <a class="product-visual" href={'/productos/' + product.id}>
    {product.image ? (
      <img
        src={'/api/productos/' + product.id}
        alt={product.name}
        loading="lazy"
        width="440"
        height="440"
      />
    ) : (
      <span class="no-product-image">
        <Icon name="paw" size={55} />
        <small>Imagen por agregar</small>
      </span>
    )}
    {available < 1 && <span class="product-stock-label">Sin disponibilidad</span>}
  </a>
  <div class="product-info">
    <span class="product-category">{product.category || 'Esenciales'}</span>
    <a href={'/productos/' + product.id}>
      <h2>{product.name}</h2>
    </a>
    <span class="product-presentation">{product.presentation}</span>
    <div class="product-buy">
      <strong>{money(product.price)}</strong>
      <button
        class="add-to-cart"
        type="button"
        aria-label={'Agregar ' + product.name + ' al carrito'}
        disabled={available < 1}
        data-product={JSON.stringify(product)}
      >
        <Icon name="bag" size={18} />
      </button>
    </div>
  </div>
</article>
