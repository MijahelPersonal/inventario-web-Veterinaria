---
import Icon from './Icon.astro';
import { money } from '../lib/backend';
import type { Product } from '../lib/types';
interface Props {
  product: Product;
}
const { product } = Astro.props;
const available = Math.floor(Number(product.available));
---

<article class="product-card">
  <a class="product-visual" href={'/productos/' + product.id}>
    {product.on_sale && (
      <span class="discount-badge">
        {product.discount_percent ? `-${product.discount_percent}%` : 'Oferta'}
      </span>
    )}
    {product.image ? (
      <img
        src={'/api/productos/' + product.id}
        alt={product.name}
        loading="lazy"
        width="440"
        height="440"
      />
    ) : (
      <span class="no-product-image">
        <Icon name="bag" size={45} />
        <small>Fotografía por agregar</small>
      </span>
    )}
    <span class:list={['product-stock-label', { unavailable: available < 1 }]}>
      {available > 0 ? 'Disponible' : 'Agotado'}
    </span>
  </a>
  <div class="product-info">
    <span class="product-category">{product.brand || product.category || 'StruchVet'}{product.demo && ' · Prueba'}</span>
    <a href={'/productos/' + product.id}>
      <h2>{product.name}</h2>
    </a>
    <span class="product-presentation">
      {product.presentation || product.category || 'Cuidado para tu mascota'}
    </span>
    <div class="product-buy">
      <span class="price-stack">
        {product.on_sale && <del>{money(product.regular_price || product.price)}</del>}
        <strong>{money(product.price)}</strong>
      </span>
      <button
        class="add-to-cart"
        type="button"
        aria-label={'Agregar ' + product.name + ' al carrito'}
        disabled={available < 1}
        data-product={JSON.stringify(product)}
      >
        <Icon name="bag" size={19} />
      </button>
    </div>
  </div>
</article>
