<div class="form-grid">
  <label>
    Tu nombre <span>*</span>
    <input
      name="name"
      autocomplete="name"
      maxlength="120"
      placeholder="¿Cómo te llamas?"
      required
    />
  </label>
  <label>
    Teléfono de contacto <span>*</span>
    <input
      name="phone"
      type="tel"
      autocomplete="tel"
      maxlength="40"
      minlength="6"
      placeholder="Tu número de contacto"
      required
    />
  </label>
  <label class="full-field">
    Correo electrónico <small>(opcional)</small>
    <input
      name="email"
      type="email"
      autocomplete="email"
      maxlength="190"
      placeholder="hola@ejemplo.com"
    />
  </label>
</div>
